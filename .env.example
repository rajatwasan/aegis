# Aegis configuration (copy to .env; never commit real values)

# Agent provider. "mock" (default, no key) runs the three scripted console
# chips. "anthropic" lets a model read any console instruction and propose one
# action through the same policy gate and human approval; it needs a key.
AEGIS_LLM=mock
AEGIS_LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=sk-ant-placeholder-not-a-real-key

# Local chain
AEGIS_RPC_URL=http://127.0.0.1:8545
AEGIS_CHAIN_ID=31337

# --- Operator key -----------------------------------------------------------
# Deploys the suite, performs the agent's plain transfers and pays for anchors.
# Read from the environment only; state.json carries the address, never the
# key. On a dev chain an unset value falls back to anvil's dev key 0 (and says
# so); on a public chain it is required and an anvil key is refused.
# AEGIS_DEPLOYER_KEY is accepted as an alias. Testnet throwaway keys only.
AEGIS_OPERATOR_KEY=0xREPLACE_WITH_A_FUNDED_KEY_YOU_GENERATED

# --- Public-chain anchoring (optional; see docs/adr/005) -------------------
# Point AEGIS_RPC_URL at a public chain so every anchored Merkle root is a
# transaction a third party can inspect. Base Sepolia:
#   AEGIS_RPC_URL=https://sepolia.base.org
# Override the built-in explorer table (forks, unlisted networks)
# AEGIS_EXPLORER_URL=https://sepolia.basescan.org

# Approval service
AEGIS_APPROVAL_URL=http://127.0.0.1:8000
AEGIS_APPROVAL_TTL_SECONDS=900
AEGIS_DUAL_CONTROL=false

# Approver credentials. REQUIRED. Every approve and reject carries a bearer
# token; the service derives who approved from it and records that in the
# audit log. Format: id:token,id:token (ids lowercase, tokens >= 24 chars).
# Generate: python -c "import secrets; print(secrets.token_hex(24))"
# make dev mints a token for the approver "dev" when this is unset.
AEGIS_APPROVER_TOKENS=ops-1:REPLACE_WITH_A_LONG_RANDOM_TOKEN
# Operator token that mints passkey pairing codes (guardian phone screen).
AEGIS_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN

# Guardian signer private key. REQUIRED. There is no default: generate one
#   python -c "from eth_account import Account; from web3 import Web3; a=Account.create(); print(a.address, Web3.to_hex(a.key))"
# and keep it out of version control. On a dev chain (anvil, chain id 31337)
# an unset value falls back to anvil's dev key 9 and says so on stderr; on any
# public chain an unset or anvil key refuses to start. The placeholder below
# fails validation on purpose.
AEGIS_GUARDIAN_KEY=0xREPLACE_WITH_A_KEY_YOU_GENERATED

# Audit log signing key file (generated locally, git-ignored)
AEGIS_AUDIT_KEY_FILE=.aegis/audit_signing.key

# Guardian passkeys (WebAuthn): the domain the FRONTEND page is served from,
# not the API domain (e.g. console.example.org / https://console.example.org).
# Defaults to the local vite origin on a dev chain; required on a public chain.
# Pairing codes are minted by the operator: POST /guardian/pair/start with
# Authorization: Bearer $AEGIS_ADMIN_TOKEN, or `aegis guardian pair-code`.
AEGIS_RP_ID=localhost
AEGIS_EXPECTED_ORIGIN=http://localhost:5173

# Policy the gate applies. Required on a public chain. policies/dev.yaml is
# the dev chain policy (its allowlist is anvil's accounts) and is used, with a
# notice, only when this is unset on a dev chain.
AEGIS_POLICY_PATH=policies/dev.yaml

# deploy/start.sh: allow falling back to a disposable local anvil when the
# configured public deploy fails. Off by default; a hosted service should fail.
AEGIS_ALLOW_LOCAL_FALLBACK=false
