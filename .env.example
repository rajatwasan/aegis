# Aegis configuration (copy to .env; never commit real values)

# Agent provider for the console and the graph: "mock" (default; scripted, the
# three canned instructions only, no key) or "anthropic" (free text through the
# real model; requires BOTH variables below, there is no silent fall back).
AEGIS_LLM=mock
# AEGIS_ANTHROPIC_MODEL=<model id you have access to>
# ANTHROPIC_API_KEY=<your key>
# AEGIS_AGENT_MAX_STEPS=8   # model turns per free text run before it is stopped

# Local chain
AEGIS_RPC_URL=http://127.0.0.1:8545
AEGIS_CHAIN_ID=31337

# --- Public-chain anchoring (optional; see docs/adr/005) -------------------
# Point AEGIS_RPC_URL at a public chain and supply a FUNDED key to make every
# anchored Merkle root a transaction a third party can inspect. Base Sepolia:
#   AEGIS_RPC_URL=https://sepolia.base.org
# The deployer key deploys the suite and sends anchor transactions. Testnet
# throwaway keys only — never a key that holds anything of value.
AEGIS_DEPLOYER_KEY=0xreplace-with-a-funded-testnet-key
# Override the built-in explorer table (forks, unlisted networks)
# AEGIS_EXPLORER_URL=https://sepolia.basescan.org

# Rolling window for the policy's within_daily_limit predicate, in seconds.
# Spend is read back from the audit log, so this is the only knob (default 24h).
# AEGIS_DAILY_WINDOW_SECONDS=86400

# Approval service
AEGIS_APPROVAL_URL=http://127.0.0.1:8000
AEGIS_APPROVAL_TTL_SECONDS=900
AEGIS_DUAL_CONTROL=false

# Guardian signer private key. REQUIRED, no default: the approval service signs
# every approved authorization with it and the token accepts only its address.
# Generate one (python -c "from eth_account import Account; print(Account.create().key.hex())")
# and keep it only where the approval service runs. Anvil's public dev keys are
# refused unless AEGIS_ALLOW_DEV_KEYS=true, which only the local dev scripts set.
AEGIS_GUARDIAN_KEY=0xreplace-with-a-key-only-the-approval-service-holds
# AEGIS_ALLOW_DEV_KEYS=true   # local anvil only; scripts/dev-stack.sh sets this itself

# Audit log signing key file (generated locally, git-ignored)
AEGIS_AUDIT_KEY_FILE=.aegis/audit_signing.key
